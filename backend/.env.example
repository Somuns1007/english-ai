# 用途：部署环境模板。复制为 .env 后填写真实值；不要提交真实 .env。
# 所有域名须替换为实际 Origin（协议 + 主机 + 必要端口，不带路径或末尾斜杠）。

# ─── DeepSeek ───────────────────────────────────────────────
# main.py 启动必须设置；实际密钥只保存在 .env / 服务环境中。
DEEPSEEK_API_KEY=

# ─── Auth ───────────────────────────────────────────────────
# 至少 32 字节，使用 openssl rand -hex 32 生成；所有 worker 使用同一个密钥。
# 当前实现是在认证请求时校验，不是启动时校验；缺失时注册/登录返回 503。
AUTH_JWT_SECRET=

# 默认路径由模块目录定位为 backend/auth/data/auth.db，不依赖工作目录。
# 如覆盖路径，生产应使用绝对路径，并给予 www-data 对父目录的写权限。
# AUTH_DB_PATH=/data/english-ai/auth.db

# 生产 HTTPS 必须为 true；仅本地 HTTP 开发可显式设为 false。
AUTH_COOKIE_SECURE=true

# 允许的认证请求 Origin（逗号分隔），配合 X-Auth-Request 请求头做 CSRF 校验。
AUTH_ALLOWED_ORIGINS=https://你的域名

# 管理员由 auth.admin 对已有账号一次性授权，不按注册邮箱自动授予权限。
# 账号权限验证完成后改 false，关闭图片与听力的旧教师口令入口。
AUTH_ALLOW_LEGACY_TEACHER_TOKEN=true
# 先配置并验证真实投递，再改 true 强制新注册验证码；旧账号仍能登录。
AUTH_EMAIL_VERIFICATION_REQUIRED=false
AUTH_MAIL_DAILY_LIMIT=200
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
# 只允许 ssl / starttls，禁止明文 SMTP。
AUTH_SMTP_SECURITY=ssl
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_MAIL_FROM=

# ─── Listening ──────────────────────────────────────────────
# 默认模块路径为 backend/listening/data/listening.db。
# systemd EnvironmentFile 会在 Python 导入前注入此变量。
# LISTENING_DB_PATH=/data/english-ai/listening.db

# 教师口令可选：不设则教师端点拒绝请求；请生成与 JWT 密钥不同的口令。
# TEACHER_TOKEN=

# 生产保持未设置；不得绕过 student_release_allowed=false 的发布闸门。
# ALLOW_UNRELEASED_LISTENING_V2=false

# ─── CORS ───────────────────────────────────────────────────
# 明确列出允许的浏览器 Origin；带 cookie 时不要使用通配符 *。
# 未设置时仍默认 localhost:5173 / 127.0.0.1:5173。
CORS_ALLOWED_ORIGINS=https://你的域名

# ─── 测试专用（生产禁止设置）─────────────────────────────────
# 此开关牺牲 SQLite 掉电耐久性，只能用于临时测试数据库。
# LISTENING_UNSAFE_FAST_DB=1
